# Variáveis de Ambiente da API
# Copie este arquivo para .env e preencha os valores antes de executar em produção.

# Nome do Projeto
PROJECT_NAME="Jiu-Jitsu Management API"

# Configuração de Conexão com o Banco de Dados (PostgreSQL via AsyncPG)
DATABASE_URL="postgresql+asyncpg://postgres:92d5610b7538427a7268173f@localhost:5432/postgres"

# Configurações do JWT e Autenticação
# ATENÇÃO: GERE UMA CHAVE SECRETA NOVA E FORTE PARA PRODUÇÃO!
# Exemplo para gerar uma chave: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7"
ALGORITHM="HS256"

# Tempo de expiração das sessões
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Criação do primeiro usuário Admin (Auto-criado ao ligar o servidor se não existir)
ADMIN_EMAIL="admin@jiujitsu.com"
ADMIN_PASSWORD="admin_password"